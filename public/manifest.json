{
    "name": "Chrome For Everyone",
    "description": "Confidently navigate the web in any language.",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": [
        "tabs",
        "activeTab",
        "scripting",
        "sidePanel", 
        "notifications"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [{
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "css": ["widget.css"],
        "run_at": "document_end"
    }],
    "action": {
        "default_title": "Smart Search"
    },
    "side_panel": {
        "default_path": "src/panel/panel.html"
    },
    "web_accessible_resources": [
        {
            "resources": ["smd.js"],
            "matches": ["<all_urls>"]
        }
    ],
    "host_permissions": [
        "<all_urls>"
    ],
