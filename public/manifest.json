{
    "name": "Meridian",
    "description": "Confidently navigate the web in any language.",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": [
        "tabs",
        "activeTab",
        "scripting",
        "sidePanel", 
        "notifications",
        "contextMenus",
        "storage"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [{
        "matches": ["<all_urls>"],
        "js": ["utils/tooltip.js", "src/content.js"],
        "css": ["content.css"],
        "run_at": "document_end",
        "all_frames": true
    }],
    "action": {
        "default_title": "Meridian: Navigate the Internet, Explore the World"
    },
    "side_panel": {
        "default_path": "src/panel/panel.html"
    },
    "web_accessible_resources": [
        {
            "resources": ["pdf_viewer/*"],
            "matches": ["<all_urls>"]
        },
        {
            "resources": ["utils/*"],
            "matches": ["<all_urls>"]
        }
    ],
    "host_permissions": [
        "<all_urls>"
    ],
