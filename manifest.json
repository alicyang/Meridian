{
  "name": "Chrome For Everyone",
  "description": "Confidently navigate the web in any language.",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "tabs", 
    "activeTab", 
    "scripting"
  ], 
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html", 
    "default_title": "Smart Search"
  }
}